# All inference is local. The boot-time assert in lib/ai/generate.ts rejects
# any host that is not a loopback address — see CLAUDE.md.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Never unloads. The default 5-minute unload is a 20-60s dead pause mid-demo.
OLLAMA_KEEP_ALIVE=-1

MODEL_AR=hf.co/mradermacher/Fanar-1-9B-Instruct-GGUF
MODEL_EN=gemma-4-12b
MODEL_EMBED=bge-m3

# The full catalogue. `docker compose up -d` serves this on 5432 by default —
# set DB_PORT as well if something already holds that port on your machine.
DATABASE_URL=postgresql://aimarketing:aimarketing@127.0.0.1:5432/aimarketing
# DB_PORT=5434

# Evaluation only, against invented sample products. Never real catalog data.
# Left blank by default and read only by the eval module.
EVAL_CLOUD_API_KEY=

# Publishing (D83, D86). The only credentials here that are not local — the
# rendered poster and its caption reach Meta and Cloudinary, per post, on a click.
# Placeholders only; the real values live in .env, which is not tracked.
#
# These are the INSTAGRAM app id and secret from the Meta app dashboard
# (Instagram > API setup with Instagram login), not the Facebook app id beside
# them. They are different numbers and the Facebook one fails at the token
# exchange with a message about the client secret.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# HTTPS, not HTTP. Meta refuses to save an http redirect URI for Instagram
# business login — "Error saving redirect URIs" and nothing more. Run the app
# with `npm run dev:https` so this address exists.
INSTAGRAM_REDIRECT_URI=https://localhost:3000/api/social/instagram/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Encrypts the stored Instagram tokens at rest. A long-lived token is a standing
# permission to post as the company. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
