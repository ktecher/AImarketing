# All inference is local. The boot-time assert in lib/ai/generate.ts rejects
# any host that is not a loopback address — see CLAUDE.md.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Never unloads. The default 5-minute unload is a 20-60s dead pause mid-demo.
OLLAMA_KEEP_ALIVE=-1

MODEL_AR=hf.co/mradermacher/Fanar-1-9B-Instruct-GGUF
MODEL_EN=gemma-4-12b
MODEL_EMBED=bge-m3

DATABASE_URL=postgresql://localhost:5432/aimarketing

# Evaluation only, against invented sample products. Never real catalog data.
# Left blank by default and read only by the eval module.
EVAL_CLOUD_API_KEY=
