node_modules/
.next/
out/
build/
dist/

.env
.env.local
.env*.local

# Company data — never committed, never leaves this machine
# A trailing-slash pattern excludes the DIRECTORY, and git will not descend into
# an excluded directory — so `!data/samples/.gitkeep` below could never re-include
# the keepfile, and a fresh clone had no data/samples at all. Exclude the
# contents, not the directory.
data/samples/*
data/uploads/
!data/samples/.gitkeep
# The imported catalogue and every draft written about it. Real SKUs and real
# prices are competitive information; the rule is the same as for the sheet.
data/state/

# Fonts are excluded BY DEFAULT, because a brand face may carry a commercial
# licence that forbids redistribution. The OFL 1.1 families below are re-included
# by name, with their licence text beside them, so a clone renders out of the box.
# A new font dropped into this folder stays excluded until somebody checks it.
data/fonts/*
!data/fonts/.gitkeep
!data/fonts/LICENCE-NOTES.md
!data/fonts/OFL-Cairo.txt
!data/fonts/OFL-Tajawal.txt
!data/fonts/Cairo-Variable.ttf
!data/fonts/Tajawal-Regular.ttf
!data/fonts/Tajawal-Bold.ttf

# Generated output
renders/
*.zip

.DS_Store
*.log
.omc/

# Agent working notes — real prices, real SKUs. Same rule as the sheet.
.scratch/

# Scraped product pages — real names, prices, discounts, live URLs and photos.
# Same rule as the sheet: competitive information, never committed.
retailer-products/

# Brand artwork is embedded in the template SVG, and the overrides carry real
# SKUs. `npx tsx scripts/make-template-svg.mjs` rebuilds the poster from
# data/samples/, so a clone regenerates what it needs.
data/templates/*.svg
data/templates/*.overrides.json

# Build artifact, rewritten by every typecheck
tsconfig.tsbuildinfo

# Snapshots taken before a destructive route runs. Real catalogue data.
data/.trash/
