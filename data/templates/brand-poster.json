{
  "v": 1,
  "name": "Brand poster A4",
  "slots": [
    {
      "id": "image",
      "type": "image",
      "bind": "image",
      "fit": "contain"
    },
    {
      "id": "name_en",
      "type": "text",
      "bind": "display_name",
      "font": "Cairo",
      "size": 22,
      "maxLines": 2,
      "align": "center",
      "colour": "#123c46"
    },
    {
      "id": "name_ar",
      "type": "text",
      "bind": "name_ar",
      "font": "Cairo",
      "size": 18,
      "maxLines": 2,
      "align": "center",
      "colour": "#123c46"
    },
    {
      "id": "was",
      "type": "text",
      "bind": "price_was",
      "format": "kwd",
      "font": "Cairo",
      "size": 15,
      "maxLines": 1,
      "align": "center",
      "colour": "#8a8a86",
      "visible": "price_was",
      "strike": true
    },
    {
      "id": "price",
      "type": "text",
      "bind": "price_now",
      "format": "kwd",
      "font": "Cairo",
      "size": 32,
      "maxLines": 1,
      "align": "center",
      "colour": "#0f8a86"
    },
    {
      "id": "discount",
      "type": "text",
      "bind": "discount_label",
      "font": "Cairo",
      "size": 18,
      "maxLines": 1,
      "align": "end",
      "colour": "#c0392b",
      "visible": "discount_pct"
